{
  "name": "anilist-stats",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "prisma generate && nuxt build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:frontend": "vitest --config vitest.frontend.config.ts",
    "test:frontend:run": "vitest run --config vitest.frontend.config.ts",
    "test:frontend:verbose": "vitest run --config vitest.frontend.config.ts --reporter=verbose",
    "test:perf": "vitest run --config vitest.perf.config.ts --reporter=verbose",
    "test:perf:live": "powershell -NoProfile -Command \"$env:VITEST_PERF_REAL_USER='1'; vitest run --config vitest.perf.config.ts --reporter=verbose\"",
    "test:all": "npm run test:run && npm run test:frontend:run && npm run test:perf:live",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:install": "playwright install chromium"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "h3": "^1.15.11",
    "nuxt": "^4.2.2",
    "pg": "^8.23.1",
    "vue": "^3.5.26",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "^25.0.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.23",
    "happy-dom": "^21.0.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^4.0.18"
  }
}
